// Brutal Doom 22 kick/slide FPS sheets (KICK / SLID + 1/2/3 smeared boots).
// Gameplay (damage, crouch-slide, momentum) is Universal Kick / STALKER rules.

Class BootsSmearedWithRedBlood : Inventory
{
	Default
	{
		Inventory.MaxAmount 20;
		+INVENTORY.UNDROPPABLE
		+INVENTORY.UNTOSSABLE
	}

	Override Void DoEffect()
	{
		Super.DoEffect();
		if (!Owner || Amount <= 0) return;
		if ((GetAge() % 105) == 0)
		{
			Amount--;
			if (Amount <= 0) Destroy();
		}
	}
}

Class BootsSmearedWithBlueBlood : BootsSmearedWithRedBlood {}
Class BootsSmearedWithGreenBlood : BootsSmearedWithRedBlood {}

Class MR_KickBootSmear play
{
	// Red / blue / green FPS boot sheets from victim BloodType / BloodColor.
	static void Apply(Actor kicker, Actor victim)
	{
		if (!kicker || !victim || !kicker.player) return;
		if (victim.player) return;
		if (!victim.bSHOOTABLE) return;

		bool green = false;
		bool blue = false;
		Class<Actor> bt = victim.BloodType;
		if (bt)
		{
			String bn = bt.GetClassName();
			if (bn.IndexOf("Green") >= 0 || bn.IndexOf("Acid") >= 0)
				green = true;
			else if (bn.IndexOf("Blue") >= 0)
				blue = true;
		}

		Color c = victim.bloodcolor;
		int r = c.r, g = c.g, b = c.b;
		if (!green && !blue && (r | g | b) != 0)
		{
			if (g >= r + 15 && g >= b + 15) green = true;
			else if (b >= r + 15 && b >= g + 15) blue = true;
		}

		kicker.TakeInventory("BootsSmearedWithRedBlood", 99);
		kicker.TakeInventory("BootsSmearedWithBlueBlood", 99);
		kicker.TakeInventory("BootsSmearedWithGreenBlood", 99);
		if (green)
			kicker.GiveInventory("BootsSmearedWithGreenBlood", 12);
		else if (blue)
			kicker.GiveInventory("BootsSmearedWithBlueBlood", 12);
		else
			kicker.GiveInventory("BootsSmearedWithRedBlood", 12);
	}
}

Class MR_uKickToken : CustomInventory
{
	Float PosZ;
	action Actor A_FireProjectileLZDoom(class<Actor> missiletype, double angle = 0, double spawnofs_xy = 0, double spawnheight = 0, int flags = 0, double pitch = 0)
	{
		let player = self.player;
		if (!player) return null;

		let weapon = player.ReadyWeapon;

		FTranslatedLineTarget t;

		if (missiletype)
		{
			double ang = self.Angle - 90;
			Vector2 ofs = AngleToVector(ang, spawnofs_xy);
			double shootangle = self.Angle;

			if (flags & FPF_AIMATANGLE) shootangle += angle;

			double saved_player_pitch = self.Pitch;
			self.Pitch += pitch;

			Actor misl, realmisl;
			[misl, realmisl] = SpawnPlayerMissile(missiletype, shootangle, ofs.X, ofs.Y, spawnheight, t, false, (flags & FPF_NOAUTOAIM) != 0);
			self.Pitch = saved_player_pitch;

			if (realmisl && flags & FPF_TRANSFERTRANSLATION)
				realmisl.Translation = Translation;

			return realmisl;
		}
		return null;
	}

	bool KickHasHitObject, Kickin, LeftKick, SlideAutoCrouch;
	double PlrZpos, SlideAng, SlideMom;
	int Falling, SlideExtra, SlideTicsLeft, SlideCooldownUntil;
	Vector2 WeapOfst, Ofst;
	Default
	{
		Inventory.MaxAmount 1;
		+INVENTORY.UNDROPPABLE
		+INVENTORY.UNTOSSABLE
	}

	Override Void DoEffect()
	{
		if(Kickin && Ofst.X <= 25)
		{
			TextureId Sprit;
			if(Owner.Player.GetPSprite(PSP_WEAPON).CurState)
				Sprit = Owner.Player.GetPSprite(PSP_WEAPON).CurState.GetSpriteTexture(0);

			Vector2 Size = (1,1);
			Size = Texman.GetScaledSize(Sprit);

			if(Size.X<=1 && Owner.Player.GetPSprite(PSP_FLASH).CurState){
				Sprit = Owner.Player.GetPSprite(PSP_FLASH).CurState.GetSpriteTexture(0);
				Size = Texman.GetScaledSize(Sprit);
			}

			if(Sprit.IsValid()){
				Owner.Player.GetPSprite(PSP_WEAPON).X = WeapOfst.X+Ofst.X*(LeftKick?1.5:-1.5);
				Owner.Player.GetPSprite(PSP_WEAPON).Y = WeapOfst.Y+Ofst.Y*1.25;
				Owner.Player.GetPSprite(PSP_WEAPON).Pivot = (.5, 0);
				Owner.Player.GetPSprite(PSP_WEAPON).Rotation = -Owner.Player.GetPSprite(PSP_WEAPON).X*.3;
			}

			if(Ofst.X < 25)Ofst += (Min(7, 25 - Ofst.X), min(8, 29 - Ofst.Y));
		}
		else if(!Kickin && Ofst != (0, 0))
		{
			Owner.Player.GetPSprite(PSP_WEAPON).X = WeapOfst.X+Ofst.X*(LeftKick?1.5:-1.5);
			Owner.Player.GetPSprite(PSP_WEAPON).Y = WeapOfst.Y+Ofst.Y*1.25;
			Owner.Player.GetPSprite(PSP_WEAPON).Pivot = (.5, 0);
			Owner.Player.GetPSprite(PSP_WEAPON).Rotation = -Owner.Player.GetPSprite(PSP_WEAPON).X*.3;

			Ofst -= (4, 8);

			if(Ofst.X < 1 || Ofst.Y < 1){Ofst = (0, 0);Owner.Player.GetPSprite(PSP_WEAPON).Rotation=0;LeftKick=False;}
		}
	}

	Void MRKick_GetWeapOfst()
	{
		if(!Owner.Player.FindPSprite(PSP_WEAPON))Return;
		if(Ofst!=(0, 0))
		{
			Ofst = (0, 0);
			Owner.Player.GetPSprite(PSP_WEAPON).X = WeapOfst.X;
			Owner.Player.GetPSprite(PSP_WEAPON).Y = WeapOfst.Y;
			LeftKick = false;
		}
		WeapOfst = (Owner.Player.GetPSprite(PSP_WEAPON).X, Owner.Player.GetPSprite(PSP_WEAPON).Y);
		Kickin = True;
	}

	// Shared slide-loop motion / hit probe (BD holds SLID E during the run).
	action bool MR_WantSlideKick()
	{
		// Brief pause after a slide before another can start (3s @ 35 tics).
		if (level.time < invoker.SlideCooldownUntil)
			return false;

		// Classic: crouch / already ducked.
		if (Player.cmd.buttons & BT_CROUCH)
			return true;
		let legs = MR_uLegsToken(FindInventory("MR_uLegsToken"));
		if (legs && Height < legs.MaxHeight * 0.9)
			return true;

		// Run / sprint: on ground, moving with real speed, stick held.
		if (pos.z > floorz + 1.5 || vel.z != 0)
			return false;
		if (Player.Cmd.ForwardMove == 0 && Player.Cmd.SideMove == 0)
			return false;
		// Doom run / always-run speed is well above this; walking-with-mouselook idle nudge is not.
		if (Vel.XY.Length() < 8.0 && !(Player.cmd.buttons & BT_SPEED))
			return false;
		return true;
	}

	action void MR_BeginSlideCrouch()
	{
		invoker.SlideAutoCrouch = false;
		if (Player.cmd.buttons & BT_CROUCH)
			return;
		// Run-slide needs ducked Height or SlideLoop ends on the first tick.
		invoker.SlideAutoCrouch = true;
		player.crouching = -1;
		player.cmd.buttons |= BT_CROUCH;
	}

	action void MR_EndSlideCrouch()
	{
		if (!invoker.SlideAutoCrouch)
			return;
		invoker.SlideAutoCrouch = false;
		if (!(Player.cmd.buttons & BT_CROUCH))
			player.crouching = 0;
	}

	action void MR_ArmSlideCooldown()
	{
		invoker.SlideCooldownUntil = level.time + 105; // 3 seconds
	}

	action void MR_SlideLoopTick()
	{
		if (invoker.SlideAutoCrouch)
		{
			player.crouching = -1;
			player.cmd.buttons |= BT_CROUCH;
		}
		if(Player.Cmd.ForwardMove!=0 || Player.Cmd.SideMove!=0)
		{
			Float DestAng = DeltaAngle(invoker.SlideAng, Angle-90+VectorAngle(Player.Cmd.SideMove, Player.Cmd.ForwardMove));
			if(DestAng!=0)invoker.SlideAng+=DestAng/7;
		}
		if(invoker.Falling>2 && Pos.Z<invoker.PosZ && Pos.Z>FloorZ+20){A_OverLay(-853,"SlideFall");Return;}
		if(Pos.Z>FloorZ+20 && Pos.Z<invoker.PosZ)invoker.Falling++;else invoker.Falling = 0;
		Vel.XY += AngleToVector(invoker.SlideAng, 1) * (2.0 * invoker.SlideMom);
		// Soft decay so sprint slides don't self-sustain forever.
		invoker.SlideMom = max(0.55, invoker.SlideMom * 0.992);
		if (invoker.SlideTicsLeft > 0)
			invoker.SlideTicsLeft--;

		A_OverlayOffset(-853, -DeltaAngle(Angle, invoker.SlideAng) *2, -Min(20, Pitch *2) + 52, WOF_INTERPOLATE);
		A_SetPitch(Min(20, Pitch));
		actor a=A_FireProjectileLZDoom("MR_uKickAttack", -Angle+invoker.SlideAng, 0, 0, FPF_AIMATANGLE, -Pitch);
		if(a){a.Master=Self;
		MR_uKickAttack(a).Slide=True;}
		CS_EjectaPush.SlidePush(PlayerPawn(self), invoker.SlideAng);

		let legs = MR_uLegsToken(FindInventory("MR_uLegsToken"));
		bool stoodUp = legs && Height > legs.MaxHeight * .75;
		bool releasedCrouch = !invoker.SlideAutoCrouch && !(Player.cmd.buttons & BT_CROUCH);
		bool timedOut = invoker.SlideTicsLeft <= 0;
		bool wantEnd = Invoker.KickHasHitObject || stoodUp || releasedCrouch || timedOut
			|| pos.z > invoker.PlrZpos;

		if (wantEnd)
			A_OverLay(-853,"LowerKick");
	}

	States
	{
	Use:
		TNT1 A 0 {A_OverLay(-853,"Kicking", true);Invoker.KickHasHitObject=false;A_StopSound(4);}
		Fail;
	Pickup:
		TNT1 A 0
		{
			return true;
		}
		Stop;

	Kicking:
		#### # 0 {A_TakeInventory("MR_UKNoLegs", 2);A_GiveInventory("MR_UKNoLegs",1);}
		#### # 0 {
			A_OverlayOffset(-853, 0, 32);
			A_OverlayScale(-853, 1, 1); // was (1,0) — zero Y scale hid all ground kicks
			A_OverlayFlags(-853, PSPF_PLAYERTRANSLATED, false);
			A_OverlayFlags(-853, PSPF_ADDWEAPON, false);
		}
		NULL A 0 A_JumpIf(MR_WantSlideKick(), "SlideKick");
		NULL A 0 A_JumpIf (vel.Z != 0||pos.z>floorz, "AirKick");
		// BD boot smear select → stick with #### for the rest of the kick.
		3ICK A 0 A_JumpIfInventory("BootsSmearedWithGreenBlood", 1, 4);
		2ICK A 0 A_JumpIfInventory("BootsSmearedWithBlueBlood", 1, 3);
		1ICK A 0 A_JumpIfInventory("BootsSmearedWithRedBlood", 1, 2);
		KICK A 0;
		"####" A 1 {
			if(MR_uLegsToken(FindInventory("MR_uLegsToken")).PlrAngle-Angle < 0){A_OverlayScale(-853, -1, 1);invoker.LeftKick=True;}
			A_StartSound("MrKickSwing", CHAN_Auto, pitch: frandom(.96, 1.1));
			SetPlayerProperty(0,1,0);
			A_SetAngle(-0.5 + angle, SPF_INTERPOLATE);
			A_SetPitch(+0.5 + pitch, SPF_INTERPOLATE);
			A_SetRoll(roll-2);
			player.fov = player.desiredfov * 0.98;
			invoker.MRKick_GetWeapOfst();
			}
		"####" # 0 {If(vel.Z != 0||pos.z>floorz){
			SetPlayerProperty(0,0,0);
			A_SetAngle(+0.5 + angle, SPF_INTERPOLATE);
			A_SetPitch(-0.5 + pitch, SPF_INTERPOLATE);
			A_SetRoll(roll+2);
			player.fov = player.desiredfov;
			A_OverLay(-853, "AirKick");
			}}
		"####" B 1 {
			A_SetAngle(-0.5 + angle, SPF_INTERPOLATE);
			A_SetPitch(+0.5 + pitch, SPF_INTERPOLATE);
			A_SetRoll(roll-2);
			player.fov = player.desiredfov * 0.970;
			}
		"####" C 1 {
			A_SetAngle(-0.5 + angle, SPF_INTERPOLATE);
			A_SetPitch(+0.5 + pitch, SPF_INTERPOLATE);
			A_SetRoll(roll-2);
			player.fov = player.desiredfov * 0.965;
		}
		"####" D 1 {
			A_SetPitch(+1.25 + pitch, SPF_INTERPOLATE);
			player.fov = player.desiredfov * 0.950;
			}
		"####" E 1 A_Recoil(-1);
		"####" E 1 {
				Actor a = A_FireProjectileLZDoom("MR_uKickAttack");
				if (a) a.Master = Self;
				CS_EjectaPush.KickPush(PlayerPawn(self));
				}
		"####" EFGHIJ 1 {
			player.fov = player.desiredfov * 0.965;
			A_SetAngle(+0.5 + angle, SPF_INTERPOLATE);
			A_SetPitch(-0.25 + pitch, SPF_INTERPOLATE);
			A_SetRoll(roll+1);
		}
		"####" KLM 1 {
			A_SetAngle(+0.5 + angle, SPF_INTERPOLATE);
			A_SetPitch(-0.5 + pitch, SPF_INTERPOLATE);
			A_SetRoll(roll+1);
			player.fov = player.desiredfov * 0.99;
		}
		"####" A 1 {
			invoker.Kickin=False;
			A_SetAngle(-0.5 + angle, SPF_INTERPOLATE);
			A_SetPitch(-1.25 + pitch, SPF_INTERPOLATE);
			player.fov = player.desiredfov;
		}
		#### # 0 A_TakeInventory("MR_UKNoLegs", 2);
		#### # 0 {SetPlayerProperty(0,0,0);}
		Stop;

	SlideKick:
		#### # 0 A_GiveInventory("MR_UKNoLegs",2);
		#### # 0 {
			A_OverlayFlags(-853, PSPF_PLAYERTRANSLATED, false);
			A_OverlayFlags(-853, PSPF_ADDWEAPON, false);
			A_OverlayScale(-853, 1, 1);
			MR_BeginSlideCrouch();
		}
		3LID A 0 A_JumpIfInventory("BootsSmearedWithGreenBlood", 1, 4);
		2LID A 0 A_JumpIfInventory("BootsSmearedWithBlueBlood", 1, 3);
		1LID A 0 A_JumpIfInventory("BootsSmearedWithRedBlood", 1, 2);
		SLID A 0;
		"####" A 1 {
			invoker.SlideMom = clamp(Vel.XY.Length() / 7.0, 1.0, 2.75);
			invoker.SlideExtra = int(ceil((invoker.SlideMom - 1.0) * 16.0));
			// Hard duration so auto-crouch sprint slides always end (was forever while ducked).
			invoker.SlideTicsLeft = 18 + invoker.SlideExtra;
			if(Player.Cmd.ForwardMove==0 && Player.Cmd.SideMove==0)invoker.SlideAng = Angle;
			else invoker.SlideAng=Angle-90+VectorAngle(Player.Cmd.SideMove, Player.Cmd.ForwardMove);
			A_OverlayOffset(-853, -DeltaAngle(Angle, invoker.SlideAng) *2, -Min(20, Pitch *2) + 52);
			A_SetPitch(Min(20, Pitch));
			invoker.LeftKick = DeltaAngle(invoker.SlideAng, Angle)<0;
			invoker.MRKick_GetWeapOfst();
			invoker.KickHasHitObject=false; A_StartSound("MrSlideKick", 4);}
		"####" BC 1 {player.fov = player.desiredfov * 0.85;
			A_OverlayOffset(-853, -DeltaAngle(Angle, invoker.SlideAng) *2, -Min(20, Pitch *2) + 52);
			A_SetPitch(Min(20, Pitch));}
		"####" D 1 {player.fov = player.desiredfov * 0.80;
			A_OverlayOffset(-853, -DeltaAngle(Angle, invoker.SlideAng) *2, -Min(20, Pitch *2) + 52, WOF_INTERPOLATE);
			A_SetPitch(Min(20, Pitch));}
		"####" E 1 {player.fov = player.desiredfov * 0.75;
			A_OverlayOffset(-853, -DeltaAngle(Angle, invoker.SlideAng) *2, -Min(20, Pitch *2) + 52, WOF_INTERPOLATE);
			A_SetPitch(Min(20, Pitch));}
		"####" FG 1 {A_OverlayOffset(-853, -DeltaAngle(Angle, invoker.SlideAng) *2, -Min(20, Pitch *2) + 52, WOF_INTERPOLATE);
					A_SetPitch(Min(30, Pitch));}
		// Keep #### — never insert TNT1 here or the hold loop becomes invisible.
		"####" # 0 A_JumpIf(Height >= MR_uLegsToken(FindInventory("MR_uLegsToken")).MaxHeight * .75, "LowerKick");
		"####" # 0 A_JumpIf(Invoker.KickHasHitObject, "LowerKick");
		"####" # 0 A_StartSound("MrSlideLoop", 4, CHANF_LOOP, pitch:FRandom(.9, 1.1));
		"####" # 0 {invoker.PlrZpos = pos.z+5;}
	SlideLoop:
		// Hold BD slide pose for the full motion; LowerKick is only via MR_SlideLoopTick.
		"####" E 1 { MR_SlideLoopTick(); }
		"####" # 0 A_Jump(256, "SlideLoop");
	LowerKick:
		#### # 0 {
			player.fov = player.desiredfov;
			A_StopSound(4);
			A_StartSound("MrSlideEnd", 4, pitch:FRandom(.9, 1.1));
			A_OverlayOffset(-853, -DeltaAngle(Angle, invoker.SlideAng) *2, -Min(20, Pitch *2) + 52);
		}
		// Re-select smear in case #### was lost when jumping here from another layer.
		3LID A 0 A_JumpIfInventory("BootsSmearedWithGreenBlood", 1, 4);
		2LID A 0 A_JumpIfInventory("BootsSmearedWithBlueBlood", 1, 3);
		1LID A 0 A_JumpIfInventory("BootsSmearedWithRedBlood", 1, 2);
		SLID A 0;
		"####" DD 1 {A_OverlayOffset(-853, -DeltaAngle(Angle, invoker.SlideAng) *2, -Min(20, Pitch *2) + 52);
					A_SetPitch(Min(20, Pitch));}
		"####" FGHIJ 1 {
					invoker.SlideAng-=Player.Cmd.SideMove*.0005;
					A_OverlayOffset(-853, -DeltaAngle(Angle, invoker.SlideAng) *2, -Min(20, Pitch *2) + 52, WOF_INTERPOLATE);
					A_SetPitch(Min(20, Pitch));}
		#### # 0 A_TakeInventory("MR_UKNoLegs", 2);
		#### # 0 {
			MR_EndSlideCrouch();
			MR_ArmSlideCooldown();
			invoker.Kickin=False;
		}
		Stop;
	SlideFall:
		#### # 0 {
			invoker.Falling = 0;
			player.fov = player.desiredfov;
			A_StopSound(4);
			A_StartSound("MrSlideEnd", 4, pitch:FRandom(.9, 1.1));
			A_OverlayOffset(-853, -DeltaAngle(Angle, invoker.SlideAng) *2, -Min(20, Pitch *2) + 52);
		}
		3LID A 0 A_JumpIfInventory("BootsSmearedWithGreenBlood", 1, 4);
		2LID A 0 A_JumpIfInventory("BootsSmearedWithBlueBlood", 1, 3);
		1LID A 0 A_JumpIfInventory("BootsSmearedWithRedBlood", 1, 2);
		SLID A 0;
		"####" D 2 {A_OverlayOffset(-853, -DeltaAngle(Angle, invoker.SlideAng) *2, -Min(20, Pitch *2) + 52);
					A_SetPitch(Min(20, Pitch));}
		"####" GFEDCBA 1{
					invoker.SlideAng-=Player.Cmd.SideMove*.0005;
					A_OverlayOffset(-853, -DeltaAngle(Angle, invoker.SlideAng) *2, -Min(20, Pitch *2) + 52, WOF_INTERPOLATE);
					A_SetPitch(Min(20, Pitch-4));}
		#### # 0 A_TakeInventory("MR_UKNoLegs", 2);
		#### # 0 {
			MR_EndSlideCrouch();
			MR_ArmSlideCooldown();
			invoker.Kickin=False;
		}
		Stop;

	AirKick:
		#### # 0 {A_TakeInventory("MR_UKNoLegs", 2);A_GiveInventory("MR_UKNoLegs",2);}
		#### # 0 {
			A_OverlayOffset(-853, 0, 32);
			A_OverlayScale(-853, 1, 1);
			A_StartSound("MrKickSwing", CHAN_Auto, pitch:FRandom(.87,.94));
			A_Recoil (-6);
			player.fov = player.desiredfov * 0.95;
			A_OverlayFlags(-853,PSPF_PLAYERTRANSLATED, false);
			A_OverlayFlags(-853, PSPF_ADDWEAPON, false);
			invoker.MRKick_GetWeapOfst();
		}
		3ICK A 0 A_JumpIfInventory("BootsSmearedWithGreenBlood", 1, 4);
		2ICK A 0 A_JumpIfInventory("BootsSmearedWithBlueBlood", 1, 3);
		1ICK A 0 A_JumpIfInventory("BootsSmearedWithRedBlood", 1, 2);
		KICK A 0;
		// BD AirKick: NOPQ → hit on R → RRSTUVWXYZ[]
		"####" N 1 A_SetRoll(roll-2, SPF_INTERPOLATE);
		"####" O 1 A_SetRoll(roll-2, SPF_INTERPOLATE);
		"####" P 1 A_SetRoll(roll-2, SPF_INTERPOLATE);
		"####" Q 1;
		"####" R 0 {
				actor a=A_FireProjectile("MR_uKickAttack");
				 if(a){a.Master=Self;
				 MR_uKickAttack(a).Air=True;}
				CS_EjectaPush.KickPush(PlayerPawn(self), 100., 8.5);
		}
		"####" # 0 {player.fov = player.desiredfov * 0.975;}
		"####" RRSTUVWX 1;
		"####" # 0 {player.fov = player.desiredfov * 0.995;}
		"####" YZ 1 A_SetRoll(roll+2, SPF_INTERPOLATE);
		"####" "[]" 1 A_SetRoll(roll+2, SPF_INTERPOLATE);
		#### # 0 A_TakeInventory("MR_UKNoLegs", 2);
		#### # 0 {
			invoker.Kickin=False;
			player.fov = player.desiredfov;
		}
		Stop;
		}
}

Class MR_uKickStunToken : CustomInventory
{
	Default
	{
		Inventory.MaxAmount 1;
		+INVENTORY.UNDROPPABLE
		+INVENTORY.UNTOSSABLE
		+INVENTORY.AUTOACTIVATE
	}
	States
	{
	Use:
		TNT1 A 2;
		TNT1 A 0 {if(Invoker.Owner&&FindState("Pain")&&Health>1)
			{SetStateLabel("Pain");Invoker.A_SetTics(10);}}
		TNT1 AA 1 {if(Health>0&&Tics>-1)A_SetTics(30);}
		TNT1 A 0 {Invoker.Destroy();}
		Stop;
	Pickup:
		TNT1 A 0
		{
			return true;
		}
		Stop;
	}
}

Class MR_uKickAttack: FastProjectile
{
	Bool Slide, Air;
	Default{
		Radius 6;
		Height 6;
		DamageType "Kick";
		Projectile;
		+NOEXTREMEDEATH
		Damage 25;
		Speed 30;
		SeeSound "none";
		DeathSound "none";
		Decal "none";
	}

	Override Void PostBeginPlay()
	{
		Super.PostBeginPlay();
	}

	override int SpecialMissileHit(Actor victim)
	{
		if (victim && (!target || victim != target) && victim.bSHOOTABLE && !victim.bDONTTHRUST)
		{
			if (Target && Target.Player)
				MR_KickBootSmear.Apply(Target, victim);

			if((Victim.Health-(Slide?3:6))>0 && Target && Target.Player){
				victim.vel.xy = AngleToVector(Target.Angle, Air?7:6);
				victim.vel.z += 3;
				if(Victim.Health>0 && !Victim.FindState("Pain.Kick", True))
					Victim.A_GiveInventory("MR_KickDamageDealer");
			}
		}
		return -1;
	}

	States
	{
	Spawn:
		TNT1 A 0
		{
			if (Slide) SetDamage(8);
			else if (Air) SetDamage(28);
			else SetDamage(25);
		}
		TNT1 A 1{
			if(Slide&&Master&&Master.vel.xy.Length()>1){
				Int Cwar = 3;
				if(Cwar==1||Cwar>2)For(int i=0;i<7;i+=CRandom(1,2)){
					int Rand=CRandom(60, 120);
					A_SpawnParticle(Color(int(Rand*frandom(1, 1.2)), int(Rand*frandom(1,1.2)), Rand), SPF_NOTIMEFREEZE|SPF_RELVEL|SPF_RELPOS, 140, CRandom(14, 18), VectorAngle(Vel.X, Vel.Y)+CRandom(-80, 80),
						-30,0,-4, VelX:-frandom(.6, 2), 0, frandom(.3, 1), 0,0, -frandom(.001, .009), .2, frandom(.006, .015), frandom(2, 3));
				}
				if(Cwar>1)For(int i=0;i<7;i+=CRandom(1,2)){
					int Rand=CRandom(70, 140);
					A_SpawnParticle(Color(int(Rand*frandom(1, 1.3)), int(Rand*frandom(1, 1.3)), Rand), SPF_NOTIMEFREEZE|SPF_RELVEL|SPF_RELPOS, 230, frandom(.4, 2), VectorAngle(Vel.X, Vel.Y)+CRandom(-60, 60),
						-35,0,-7, VelX:-frandom(.6, 2), CRandom(-1, 1), frandom(2, 5), 0,0, -frandom(.2, .4), 1, -1, -frandom(.01, .02));
				}
			}
		}
		TNT1 A 1;
		Stop;
	Death:
		TNT1 A 0;
		TNT1 A 0 {
			if(Target && Target.Player)
			{
				Master = Target;
				FLineTraceData RemoteRay;
				bool hit = LineTrace(Master.angle, Master.Radius * 3, Master.pitch, TRF_THRUACTORS, data: RemoteRay);
				if (hit && RemoteRay.HitType == TRACE_HitWall)
				{
					RemoteRay.HitLine.Activate(Master, 0, SPAC_Use);
				}
			}
		}
		TNT1 A 0 A_CheckFloor("DeathOnGround");
		TNT1 A 0 A_StartSound("MrKickHitWall", CHAN_Auto, pitch:frandom(.85, 1.15));
		TNT1 A 0 A_JumpIf(Slide, "Slide");
		TNT1 A 0 {
			For(int i=0;i<10;i+=CRandom(1,2)){
				int Rand = CRandom(130, 170);
				A_SpawnParticle(Color(Rand,Rand,Rand), SPF_RELVEL|SPF_RELPOS, 70, frandom(19, 22), Master?AngleTo(Master):0, 0,frandom(-7,7),frandom(-6,6),
				VelX:frandom(.01, .6),frandom(-.2, .2),frandom(0, .3), 0,0,-frandom(0, .05), .2, frandom(.01, .02), frandom(2, 3));
			}
		}
		TNT1 A 0 {
			if(Master&&Master.FindInventory("Mr_uKickToken")){
				Master.A_Recoil(3);
				Mr_uKickToken(Master.FindInventory("Mr_uKickToken")).KickHasHitObject=True;
			}
		}
		TNT1 A 0 Radius_Quake (2, 6, 0, 5, 0);
		TNT1 A 10;
		Stop;
	Slide:
		TNT1 A 0 A_CheckFloor(2);
		TNT1 A 0 A_StartSound("MrKickHitWall", CHAN_Auto, pitch:FRandom(.9, 1.1));
		TNT1 A 0 {
			For(int i=0;i<10;i+=CRandom(1,2)){
			int Rand = CRandom(130, 170);
			A_SpawnParticle(Color(Rand,Rand,Rand), SPF_RELVEL|SPF_RELPOS, 70, frandom(19, 22), Master?AngleTo(Master):0, 0,frandom(-7,7),frandom(-6,6),
				VelX:frandom(-.2, .2),frandom(-.2, .2),frandom(.01, .6), 0,0,-frandom(0, .02), .2, frandom(.01, .02), frandom(2, 3));
			}
		}
		TNT1 A 0 Radius_Quake (2, 6, 0, 5, 0);
		TNT1 A 0 {
			if(Master&&Master.FindInventory("Mr_uKickToken")){
				Master.A_Recoil(1);
				Mr_uKickToken(Master.FindInventory("Mr_uKickToken")).KickHasHitObject=True;
			}
		}
		TNT1 A 10;
		Stop;

	XDeath:
		TNT1 A 0 A_StartSound("MrKickPunch", CHAN_Auto, pitch:FRandom(.9, 1.1));
		TNT1 A 0 A_JumpIf(Slide, "SlideXDeath");
		TNT1 A 0 Radius_Quake (2, 6, 0, 5, 0);
		TNT1 A 10;
		Stop;
	SlideXDeath:
		TNT1 A 0 Radius_Quake (2, 6, 0, 5, 0);
		TNT1 A 0 {
			if(Master&&Master.FindInventory("Mr_uKickToken"))
			Mr_uKickToken(Master.FindInventory("Mr_uKickToken")).KickHasHitObject=True;
		}
		TNT1 A 10;
		Stop;


	DeathOnGround:
		TNT1 A 0;
		TNT1 A 0 A_StartSound("MrKickHitWall", CHAN_Auto, pitch:FRandom(.8, 1.05));
		TNT1 A 0 {
			For(int i=0;i<10;i+=CRandom(1,2)){
				int Rand = CRandom(130, 170);
				A_SpawnParticle(Color(Rand,Rand,Rand), SPF_RELVEL|SPF_RELPOS, 70, frandom(19, 22), Master?AngleTo(Master):0, 0,frandom(-7,7),frandom(-6,6),
					VelX:frandom(-.2, .2),frandom(-.2, .2),frandom(.4, 1.4), 0,0,-frandom(0, .02), .2, frandom(.01, .02), frandom(2, 3));
			}
		}
		TNT1 A 0 Radius_Quake (2, 6, 0, 5, 0);
		TNT1 A 0 A_Explode(10, 40, 0);
		TNT1 AA 5;
		Stop;
	}
}

Class MR_KickDamageDealer : CustomInventory
{
	int MobTics;
	Default{Inventory.MaxAmount 1;+INVENTORY.UNDROPPABLE+INVENTORY.UNTOSSABLE+INVENTORY.AUTOACTIVATE}
	States{Use:TNT1 A 0;Fail;Pickup:TNT1 A 0{return true;}Stop;}

	Override Void DoEffect()
	{
		if(Owner.Health>0)
		{
			if(GetAge()<2){if(Owner.FindState("Pain"))Owner.SetStateLabel("Pain");}
			else if(GetAge()<20){if(!MobTics)MobTics=Owner.Tics;Owner.Tics=-1;}

			else {Owner.Tics = MobTics;Destroy();}
		}
		else Destroy();
		Super.DoEffect();
	}
}
